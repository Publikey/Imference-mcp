{
  "name": "imference-mcp",
  "version": "0.4.0",
  "description": "MCP server for the Imference AI image & video generation API and editing tools (imference.com)",
  "type": "module",
  "license": "MIT",
  "author": "Publikey",
  "homepage": "https://imference.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Publikey/Imference-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Publikey/Imference-mcp/issues"
  },
  "bin": {
    "imference-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "bundle": "npm run build && esbuild dist/index.js --bundle --platform=node --format=esm --target=node20 --outfile=release/imference-mcp.js --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepublishOnly": "npm test",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "imference",
    "image-generation",
    "video-generation",
    "text-to-image",
    "text-to-video",
    "x402",
    "claude",
    "image-editing",
    "remove-background",
    "upscale"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@x402/evm": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "viem": "^2.55.19",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
